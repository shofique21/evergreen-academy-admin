# Evergreen Academy admin — PRODUCTION build settings.
# Copy to .env.production before `npm run build`. VITE_* values are baked into the JavaScript
# bundle at build time and are visible to anyone, so never put secrets here.

# Public HTTPS address of the backend API (same parent domain as the admin site, for cookies)
VITE_API_BASE_URL=https://api.yourschool.edu.bd/api/v1
VITE_APP_NAME="Evergreen Academy"
